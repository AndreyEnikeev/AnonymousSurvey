# ==============================================================================
# Dockerfile для сервиса Auth (C-03)
#
# Multi-stage build:
#   Stage 1 (build)   — использует полный .NET 8 SDK для сборки.
#   Stage 2 (runtime) — использует облегчённый ASP.NET 8 Runtime для запуска.
# Это уменьшает итоговый образ с ~800 МБ до ~200 МБ.
# ==============================================================================

# ------------------------------------------------------------------------------
# STAGE 1: Сборка (Build)
# ------------------------------------------------------------------------------
# Используем официальный образ SDK .NET 8.0 на базе Debian.
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build

# Задаём рабочую директорию внутри контейнера.
# Все последующие команды (COPY, RUN) будут выполняться в /src.
WORKDIR /src

# Копируем ТОЛЬКО файл проекта (.csproj).
# Это делается отдельно от копирования исходного кода, чтобы кэшировать слой
# с восстановлением NuGet-пакетов. Если код изменится, но csproj — нет,
# Docker возьмёт закэшированный слой и не будет качать пакеты заново.
COPY ["Auth.csproj", "./"]

# Восстанавливаем NuGet-пакеты.
# Если в решении несколько проектов и есть общие зависимости, это сэкономит время.
RUN dotnet restore "Auth.csproj"

# Копируем ВСЕ остальные файлы проекта (исходный код, appsettings.json и т.д.).
# Сюда же попадают папки Controllers/, DataDb/, Models/, Services/.
COPY . .

# Собираем проект в конфигурации Release (именно поэтому убираем #if DEBUG) и
# публикуем результат в папку /app/publish.
# --no-restore — потому что пакеты уже восстановлены на предыдущем шаге.
RUN dotnet publish "Auth.csproj" -c Release -o /app/publish --no-restore

# ------------------------------------------------------------------------------
# STAGE 2: Запуск (Runtime)
# ------------------------------------------------------------------------------
# Используем ASP.NET Core Runtime (без SDK). Он легче и не содержит компилятора.
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime

WORKDIR /app

# Копируем опубликованные файлы из Stage 1.
COPY --from=build /app/publish .

# Сообщаем ASP.NET Core, что сервис должен слушать порт 8080 внутри контейнера
# (стандартный порт для контейнеризованных .NET-приложений).
# По умолчанию Kestrel слушает 5000/5001, но в Docker обычно используют 8080.
ENV ASPNETCORE_URLS=http://+:8080

# Открываем порт 8080 (информационно, для документации).
EXPOSE 8080

# Команда, которая выполняется при старте контейнера.
# Точка входа — DLL, которую сгенерировал dotnet publish.
ENTRYPOINT ["dotnet", "Auth.dll"]