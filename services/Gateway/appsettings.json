{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",

  "Jwt": {
    "Issuer": "anon-survey",
    "Audience": "anon-survey-client"
  },

  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "audit-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/audit/{**catch-all}"
        },
        "AuthorizationPolicy": "default"
      },
      "surveys-route": {
        "ClusterId": "surveys-cluster",
        "Match": {
          "Path": "/api/surveys/{**catch-all}"
        },
        "AuthorizationPolicy": "default"
      },
      "my-surveys-route": {
        "ClusterId": "surveys-cluster",
        "Match": { "Path": "/api/my-surveys" },
        "AuthorizationPolicy": "default"
      },
      "admin-periods-route": {
        "ClusterId": "surveys-cluster",
        "Match": {
          "Path": "/api/admin/periods/{**catch-all}"
        },
        "AuthorizationPolicy": "default"
      },
      "admin-surveys-route": {
        "ClusterId": "surveys-cluster",
        "Match": {
          "Path": "/api/admin/surveys/{**catch-all}"
        },
        "AuthorizationPolicy": "default"
      },

      "reports-route": {
        "ClusterId": "analytics-cluster",
        "Match": {
          "Path": "/api/reports/{**catch-all}"
        },
        "AuthorizationPolicy": "default"
      },
      "export-route": {
        "ClusterId": "analytics-cluster",
        "Match": {
          "Path": "/api/admin/export"
        },
        "AuthorizationPolicy": "default"
      }
    },

    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-1": {
            "Address": "http://localhost:5135/"
          }
        }
      },
      "surveys-cluster": {
        "Destinations": {
          "surveys-1": {
            "Address": "http://localhost:5136/"
          }
        }
      },
      "analytics-cluster": {
        "Destinations": {
          "analytics-1": {
            "Address": "http://localhost:5137/"
          }
        }
      }
    }
  }
}