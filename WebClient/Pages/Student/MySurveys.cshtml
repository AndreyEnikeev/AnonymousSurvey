@* ============================================================
   O-06: История отправленных анкет.
   Данные загружаются в OnGetAsync модели (MySurveys.cshtml.cs).
   ============================================================ *@

@page
@model WebClient.Pages.Student.MySurveysModel
@{
    ViewData["Title"] = "История отправленных";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>История отправленных</h1>
    <a asp-page="/Student/Surveys" class="btn btn-outline-primary">К активным анкетам</a>
</div>

@* Блок с ошибкой загрузки данных *@
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

@* Состояние «пусто» — не ошибка, а норма, если студент ещё ничего не отправлял *@
@if (Model.Surveys is { Count: 0 } && string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-info">
        Вы пока не отправляли ни одной анкеты.
    </div>
}
else if (Model.Surveys is { Count: > 0 })
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Период</th>
                    <th>Анкета</th>
                    <th class="text-end">Статус</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Surveys)
                {
                    <tr>
                        <td>@s.PeriodName</td>
                        <td>@s.Title</td>
                        <td class="text-end">
                            @* Кнопки «Просмотреть» нет — по тем же причинам анонимности *@
                            <span class="badge bg-success">Отправлено</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}