@* ============================================================
   _ViewStart.cshtml — "какой Layout использовать по умолчанию".
   Применяется к каждой странице, если та явно не переопределила Layout.

   Пример переопределения (в конкретной странице):
     @{ Layout = null; }   // без каркаса (например, страница логина)
     @{ Layout = "_CustomLayout"; } // другой шаблон
   ============================================================ *@

@{
    // "_Layout" — это имя файла Pages/Shared/_Layout.cshtml без расширения.
    // Razor ищет его сначала в папке текущей страницы, потом в Pages/Shared/.
    // Мы держим шаблон в Shared — общий для всех.
    Layout = "_Layout";
}