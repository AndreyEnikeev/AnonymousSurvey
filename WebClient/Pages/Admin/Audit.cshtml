@page
@model WebClient.Pages.Admin.AuditModel
@{
    ViewData["Title"] = "Журнал аудита";
}

<h1 class="mb-4">Журнал событий безопасности</h1>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

@* Форма фильтрации *@
<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Тип события</label>
                <select name="eventType" class="form-select">
                    <option value="">Все</option>
                    <option value="login_success" selected="@(Model.EventType == "login_success")">Успешный вход</option>
                    <option value="login_failed" selected="@(Model.EventType == "login_failed")">Неудачный вход</option>
                    <option value="period_status_changed" selected="@(Model.EventType == "period_status_changed")">Смена статуса периода</option>
                    <option value="password_reset_requested" selected="@(Model.EventType == "password_reset_requested")">Запрос сброса пароля</option>
                    <option value="email_notification_sent" selected="@(Model.EventType == "email_notification_sent")">Отправка email</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">С даты</label>
                <input type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label">По дату</label>
                <input type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">Применить</button>
            </div>
            <div class="col-md-2">
                <a asp-page="/Admin/Audit" class="btn btn-outline-secondary w-100">Сбросить</a>
            </div>
        </form>
    </div>
</div>

@* Таблица событий *@
@if (Model.EventsPage == null || !Model.EventsPage.Items.Any())
{
    <div class="alert alert-info">Событий по заданным фильтрам не найдено.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-striped align-middle font-monospace" style="font-size: 0.85rem;">
            <thead class="table-dark">
                <tr>
                    <th style="width: 150px;">Время (UTC)</th>
                    <th>Тип</th>
                    <th>Сущность</th>
                    <th>IP</th>
                    <th>Детали</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model.EventsPage.Items)
                {
                    <tr>
                        <td>@e.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>
                            @* Подсветка важных событий *@
                            <span class="badge @(e.EventType.Contains("failed") ? "bg-danger" : "bg-secondary")">
                                @e.EventType
                            </span>
                        </td>
                        <td>@e.EntityType</td>
                        <td>@e.IpAddress</td>
                        <td class="text-break">
                            @if (!string.IsNullOrEmpty(e.Details))
                            {
                                <code>@e.Details</code>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* Пагинация *@
    <nav>
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.Offset == 0 ? "disabled" : "")">
                <a class="page-link" asp-page="/Admin/Audit"
                   asp-route-eventType="@Model.EventType"
                   asp-route-from="@Model.From?.ToString("yyyy-MM-dd")"
                   asp-route-to="@Model.To?.ToString("yyyy-MM-dd")"
                   asp-route-limit="@Model.Limit"
                   asp-route-offset="@(Model.Offset - Model.Limit)">Назад</a>
            </li>

            <li class="page-item disabled">
                <span class="page-link">
                    @(Model.Offset + 1) - @(Math.Min(Model.Offset + Model.Limit, Model.EventsPage.Total)) из @Model.EventsPage.Total
                </span>
            </li>

            <li class="page-item @(Model.Offset + Model.Limit >= Model.EventsPage.Total ? "disabled" : "")">
                <a class="page-link" asp-page="/Admin/Audit"
                   asp-route-eventType="@Model.EventType"
                   asp-route-from="@Model.From?.ToString("yyyy-MM-dd")"
                   asp-route-to="@Model.To?.ToString("yyyy-MM-dd")"
                   asp-route-limit="@Model.Limit"
                   asp-route-offset="@(Model.Offset + Model.Limit)">Вперед</a>
            </li>
        </ul>
    </nav>
}