@* ============================================================
   Форма установки нового пароля (O-02, шаг 2).
   Токен берётся из query string ?token=... (ссылка из письма).
   Если токена нет или он недействителен — форма показывает ошибку.

   ВАЖНО: токен НЕ передаётся через форму. Он читается из URL
   и кладётся в скрытое поле только при рендере — так клиент
   не может подставить произвольный токен.
   ============================================================ *@

@page
@model WebClient.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Сброс пароля";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <h1 class="mb-4">Установка нового пароля</h1>

        @if (Model.Success)
        {
            @* Успех: пароль изменён. Пользователь должен войти с новым паролем.
               Старые refresh-токены при этом НЕ отзываются автоматически —
               это отдельное улучшение (см. комментарий в AuthController). *@
            <div class="alert alert-success">
                Пароль успешно изменён. <a asp-page="/Account/Login">Войдите</a> с новым паролем.
            </div>
        }
        else if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
            <a asp-page="/Account/ForgotPassword" class="btn btn-secondary">
                Запросить новую ссылку
            </a>
        }
        else
        {
            <p class="text-muted">
                Придумайте новый пароль. Он должен быть надёжным:
                не короче 8 символов, с буквами и цифрами.
            </p>

            <form method="post">
                @* Токен передаём через hidden поле. Атрибут asp-for свяжет
                   поле с моделью, но тип hidden — пользователь его не увидит
                   и не изменит (если только через DevTools, но это будет
                   его токен, ничего чужого он не получит). *@
                <input type="hidden" asp-for="Token" />

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label">Новый пароль</label>
                    <input asp-for="NewPassword" type="password" class="form-control"
                           autocomplete="new-password" minlength="8" required />
                </div>
                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label">Повторите пароль</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control"
                           autocomplete="new-password" minlength="8" required />
                </div>
                <button type="submit" class="btn btn-primary w-100">Сменить пароль</button>
            </form>
        }
    </div>
</div>